{
  "name": "halo-diglett",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Halo Infinite 'Diglett' style foxhole sniper party game for the browser",
  "scripts": {
    "dev": "vite",
    "dev:lan": "cross-env HTTPS=1 vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run test && vite build && npm run e2e",
    "models:import": "node tools/models/import.mjs"
  },
  "dependencies": {
    "@trystero-p2p/torrent": "^0.25.4",
    "three": "^0.186.1",
    "trystero": "^0.25.4"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "cross-env": "^10.1.0",
    "draco3dgltf": "^1.5.7",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
